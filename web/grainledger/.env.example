# Browser API origin. Leave empty for same-origin requests through the proxy.
# For a separate backend, use its origin without /api, e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:5080

# Development proxy target (used by Vite only).
API_PROXY_TARGET=http://localhost:5080

# Frontend development server port.
DEV_PORT=5173
