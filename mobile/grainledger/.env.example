# Copy to .env.local (ignored); fill only actual backend origins, without /api.
# APP_ENV: development | staging | production; defaults to development in dev, production in release.
EXPO_PUBLIC_APP_ENV=development

# Optional explicit override for the selected environment (also used by the Node live probe).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL_DEVELOPMENT=
EXPO_PUBLIC_API_BASE_URL_STAGING=
EXPO_PUBLIC_API_BASE_URL_PRODUCTION=

# No guessed/default origin or fallback between environments. Staging/production require HTTPS.
# Development HTTP requires APP_ENV=development AND a dev build; native transport rules still apply.
# A device needs a reachable LAN/HTTPS origin, not its localhost. No secrets in EXPO_PUBLIC_ values.
# Expo SDK 58 only loads standard .env.development/.env.production files (plus .local variants).
# For staging, select APP_ENV=staging in .env.local or the build environment; .env.staging is not loaded.

# Disposable test credentials may be provided to the optional Node live probe via
# GRAINLEDGER_AUTH_TEST_EMAIL and GRAINLEDGER_AUTH_TEST_PASSWORD in the shell environment.
# Never prefix credentials with EXPO_PUBLIC_ or commit them to this file.
